{
  "name": "chatbot-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:chatbot-ui": "node dist/chatbot-ui/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "20.3.20",
    "@angular/compiler": "20.3.20",
    "@angular/core": "20.3.20",
    "@angular/forms": "20.3.20",
    "@angular/platform-browser": "20.3.20",
    "@angular/platform-server": "20.3.20",
    "@angular/router": "20.3.20",
    "@angular/ssr": "20.3.20",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.20",
    "@angular/cli": "20.3.20",
    "@angular/compiler-cli": "20.3.20",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
